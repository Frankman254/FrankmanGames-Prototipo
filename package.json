{
  "name": "frankmangames-prototipo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && node scripts/buildMain.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "package": "npm run build && electron-builder --win portable --publish never",
    "test": "vitest run",
    "bench:sim": "vite-node scripts/benchSim.ts",
    "bench:electron": "npm run build && electron . --bench"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.3",
    "@babylonjs/loaders": "^7.54.3",
    "@babylonjs/materials": "^7.54.3"
  },
  "main": "dist-electron/main.cjs",
  "description": "Prototipo Slice 01 de FrankmanGames",
  "author": "FrankmanGames",
  "build": {
    "appId": "com.frankmangames.prototipo",
    "productName": "FrankmanGames Prototipo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "FrankmanGames-Prototipo-${version}-portable.exe"
    }
  }
}
