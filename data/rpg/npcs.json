        "nodes": {
          "hello": {
            "text": "El Charco de la Garza está al suroeste, pasado el boticario. Si el corcho tiembla, no tires: espera a que se hunda del todo.",
            "options": [
              {
                "text": "¿Cómo se pesca?",
