+// Marcha del jugador (2026-11-12): los GLB del héroe traen «Caminar» y el
+// juego nunca lo pedía. Cubre la regla pura de selección con histéresis, el
+// fallback de los modelos sin clip, la cadencia de pisadas en cada caso y la
+// integración en PlayerAvatar. Sin carga de GLB: el arnés glTF usa grupos
+// falsos con duraciones medidas en personaje.glb (0,667 s correr / 1,067 s
+// caminar) y el avatar se prueba con un modelo de juguete.
+import { Animation, AnimationGroup, NullEngine, Scene, StandardMaterial, TransformNode, Vector3, type InstantiatedEntries } from '@babylonjs/core';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { describe, expect, it } from 'vitest';
+import { loadGameData } from '../src/data';
+import type { AssetEntry } from '../src/data/worldSchema';
+import type { CharacterModel, PlayOptions } from '../src/render/characters/characterModel';
+import { GltfCharacter } from '../src/render/characters/gltfCharacter';
+import { PlayerAvatar } from '../src/render/characters/playerAvatar';
+import { AssetCache } from '../src/render/assetCache';
+import { GAIT_BAND, pickGait } from '../src/world/locomotion';
+import { evaluateClip, newPose, pointInModel } from '../src/world/anim';
+import { ANIM_STATES, proceduralAnim } from '../src/world/rigs';
+import type { AnimState } from '../src/world/rigs';
+
+const wd = JSON.parse(readFileSync(join(__dirname, '..', 'data', 'assets.json'), 'utf8')) as { templates: Record<string, { clips: Record<string, string>; runSpeed: number }> };
+
+describe('regla de marcha (histéresis)', () => {
+  const R = 2.75; // runSpeed del héroe
+  it('velocidad alta corre y baja anda, sobre la banda del paso natural', () => {
+    expect(pickGait('run', R, R, true)).toBe('run');
+    expect(pickGait('walk', R, R, true)).toBe('run');
+    expect(pickGait('run', 1.0, R, true)).toBe('walk');
+    expect(pickGait('walk', 1.0, R, true)).toBe('walk');
+  });
+  it('dentro de la banda conserva la marcha: sin parpadeo walk/run', () => {
+    const mid = R * (GAIT_BAND.runExit + GAIT_BAND.runEnter) / 2; // 0.8 de R
+    expect(mid / R).toBeGreaterThan(GAIT_BAND.runExit);
+    expect(mid / R).toBeLessThan(GAIT_BAND.runEnter);
+    expect(pickGait('run', mid, R, true)).toBe('run');
+    expect(pickGait('walk', mid, R, true)).toBe('walk');
+    // Justo en los bordes: salir de correr exige bajar de runExit; entrar, llegar a runEnter.
+    expect(pickGait('run', R * GAIT_BAND.runExit, R, true)).toBe('run');
+    expect(pickGait('run', R * GAIT_BAND.runExit - 0.01, R, true)).toBe('walk');
+    expect(pickGait('walk', R * GAIT_BAND.runEnter - 0.01, R, true)).toBe('walk');
+    expect(pickGait('walk', R * GAIT_BAND.runEnter, R, true)).toBe('run');
+  });
+  it('sin clip Caminar o sin datos de velocidad manda correr (comportamiento antiguo)', () => {
+    expect(pickGait('run', 0.1, R, false)).toBe('run');
+    expect(pickGait('walk', 0.1, R, false)).toBe('run');
+    expect(pickGait('walk', 0.1, 0, true)).toBe('run');
+  });
+});
+
+describe('el héroe procedural sabe caminar', () => {
+  it('walk está en el catálogo y sus apoyos coinciden con los pasos de animation.json', () => {
+    expect(ANIM_STATES).toContain('walk');
+    const a = proceduralAnim('humanoid');
+    const clip = a.clips['walk']!;
+    expect(clip.loop).toBe(true);
+    const wd2 = JSON.parse(readFileSync(join(__dirname, '..', 'data', 'animation.json'), 'utf8')) as {
+      models: Record<string, { events: Record<string, Array<{ t: number; type: string }>> }>;
+    };
+    const steps = wd2.models['humanoid']!.events['walk']!.filter((e) => e.type === 'footstep');
+    expect(steps.length).toBeGreaterThanOrEqual(2);
+    const pose = newPose(a.rig);
+    const height = (f: string, t: number): number => pointInModel(a.rig, evaluateClip(a.rig, clip, t, pose), f, a.sole)[1];
+    const used = new Set<string>();
+    for (const s of steps) {
+      const foot = a.feet.reduce((best, f) => (height(f, s.t) < height(best, s.t) ? f : best));
+      used.add(foot);
+      let min = Infinity;
+      for (let i = 0; i < 400; i++) min = Math.min(min, height(foot, i / 400));
+      // El pie de apoyo debe estar en su punto más bajo (< 1 cm) cuando suena el paso.
+      expect(height(foot, s.t) - min, `walk t=${s.t}`).toBeLessThan(0.01);
+    }
+    expect(used.size).toBe(2); // alterna pies
+  });
+});
+
+/** Animación mínima de 1 canal para dar duración real (frames/fps) al grupo. */
+function fakeGroup(scene: Scene, name: string, seconds: number, fps = 30): AnimationGroup {
+  const g = new AnimationGroup(name, scene);
+  const anim = new Animation('a', 'position', fps, Animation.ANIMATIONTYPE_VECTOR3, Animation.ANIMATIONLOOPMODE_CYCLE);
+  anim.setKeys([
+    { frame: 0, value: new Vector3(0, 0, 0) },
+    { frame: seconds * fps, value: new Vector3(0, 0.01, 0) },
+  ]);
+  g.addTargetedAnimation(anim, new TransformNode(name + ':n', scene));
+  g.from = 0;
+  g.to = seconds * fps;
+  return g;
+}
+
+const HERO = wd.templates['personaje']!;
+
+function gltfWith(scene: Scene, clips: Record<string, AnimationGroup>): { ch: GltfCharacter; entry: AssetEntry } {
+  const entry = {
+    kind: 'gltf', file: 'assets/models/personaje.glb', scale: 1, yawDeg: 90, runSpeed: HERO.runSpeed,
+    clips: HERO.clips, events: { run: [{ t: 0.05, type: 'footstep' as const }, { t: 0.55, type: 'footstep' as const }] },
+    palettes: {}, looks: {}, gear: {}, height: 1.75, ghost: false, parts: false, classModels: {}, wear: {},
+  } as AssetEntry & { events: Record<string, Array<{ t: number; type: 'footstep' }>> };
+  const cache = {
+    instantiate: async (): Promise<unknown> => ({
+      rootNodes: [],
+      animationGroups: Object.values(clips),
+      materials: [],
+      meshSources: [],
+      meshes: [],
+      skeletons: [],
+      animationGroupsMap: new Map(),
+      nodesMap: new Map(),
+      textures: [],
+      dispose: () => undefined,
+    }) as unknown as InstantiatedEntries,
+    // El constructor usa cache.instantiate; los demás métodos no se tocan aquí.
+  } as unknown as AssetCache;
+  const ch = new GltfCharacter(scene, 'player-test', 'player-test', entry as Extract<AssetEntry, { kind: 'gltf' }>, cache, 0.15);
+  return { ch, entry };
+}
+
+describe('controlador glTF: selección y fallback de caminar', () => {
+  it('con clip Caminar: hasClip lo ve y la cadencia sigue la duración real del paso', async () => {
+    const scene = new Scene(new NullEngine());
+    const groups = { idle: fakeGroup(scene, 'Reposo', 2), walk: fakeGroup(scene, 'Caminar', 1.067), run: fakeGroup(scene, 'Correr', 0.667) };
+    const { ch } = gltfWith(scene, groups);
+    await ch.ready;
+    expect(ch.hasClip('walk')).toBe(true);
+    expect(ch.clipSeconds('walk')).toBeCloseTo(1.067, 3);
+    ch.play('walk');
+    expect(ch.state).toBe('walk');
+    // A velocidad 1,375 m/s el caminar natural (2,75·0,667/1,067 = 1,718) da ratio ≈0,8.
+    ch.update(0.016, 1.375);
+    expect(groups.walk.speedRatio ?? 0).toBeLessThan(1);
+    // Correr con el mismo modelo conserva la regla antigua (runSpeed exacto).
+    ch.play('run');
+    ch.update(0.016, 2.75);
+    expect(groups.run.speedRatio ?? 0).toBeCloseTo(1, 2);
+    scene.dispose();
+  });
+  it('sin clip Caminar: walk usa el grupo de correr y su velocidad natural, como antes', async () => {
+    const scene = new Scene(new NullEngine());
+    const groups = { idle: fakeGroup(scene, 'Reposo', 2), run: fakeGroup(scene, 'Correr', 0.667) };
+    const { ch } = gltfWith(scene, groups);
+    await ch.ready;
+    expect(ch.hasClip('walk')).toBe(false);
+    ch.play('walk');
+    // El clip usado es el de correr: su ratio sigue la fórmula clásica.
+    ch.update(0.016, 1.375);
+    expect(groups.run.speedRatio ?? 0).toBeCloseTo(1.375 / 2.75, 3);
+    // Y es bucle: nunca queda "finished" a mitad (contrato del idle/run).
+    expect(ch.finished).toBe(false);
+    expect(ch.state).toBe('walk');
+    scene.dispose();
+  });
+  it('los tres estados se funden: al pasar idle→walk→run el anterior baja de peso y no se corta', async () => {
+    const scene = new Scene(new NullEngine());
+    const groups = { idle: fakeGroup(scene, 'Reposo', 2), walk: fakeGroup(scene, 'Caminar', 1.067), run: fakeGroup(scene, 'Correr', 0.667) };
+    const { ch } = gltfWith(scene, groups);
+    await ch.ready;
+    ch.play('idle');
+    ch.play('walk');
+    ch.update(0.016, 1); // un frame dentro de blendSeconds (0,15)
+    const idleW = groups.idle.animatables[0]?.weight ?? 0;
+    const walkW = groups.walk.animatables[0]?.weight ?? 0;
+    expect(idleW, 'el reposo se apaga poco a poco').toBeGreaterThan(0);
+    expect(idleW).toBeLessThan(1);
+    expect(walkW).toBeGreaterThan(0);
+    ch.play('run');
+    for (let i = 0; i < 20; i++) ch.update(0.016, 3);
+    expect(groups.idle.isPlaying, 'fundido terminado: el reposo se paró').toBe(false);
+    expect(groups.walk.isPlaying).toBe(false);
+    expect(groups.run.isPlaying).toBe(true);
+    scene.dispose();
+  });
+});
+
+/** Modelo de juguete: apunta los `play` que recibe el avatar. */
+class FakeModel implements CharacterModel {
+  root: TransformNode;
+  height = 1.7;
+  meshes = [];
+  plays: AnimState[] = [];
+  played: AnimState | null = null;
+  constructor(private readonly canWalk: boolean, scene: Scene) {
+    this.root = new TransformNode('fake', scene);
+  }
+  get state(): AnimState | null { return this.played; }
+  get finished(): boolean { return true; }
+  hasClip(s: AnimState): boolean { return s !== 'walk' || this.canWalk; }
+  runSpeed = 2.75;
+  impactTime(): number { return 0.5; }
+  clipSeconds(): number { return 1; }
+  play(state: AnimState, _opts?: PlayOptions): void { this.plays.push(state); this.played = state; }
+  update(): never[] { return []; }
+  socket(_j: string, out: Vector3): Vector3 { return out; }
+  lowestFoot(out: Vector3): Vector3 { return out.set(0, 0, 0); }
+  setEmissive(): void {}
+  setShade(): void {}
+  dispose(): void {}
+}
+
+function playerAt(speed: number): Parameters<PlayerAvatar['sync']>[0] {
+  return {
+    alive: true, pos: { x: 0, y: 0 }, prevPos: { x: 0, y: 0 }, path: [new Vector3(1, 0, 0)],
+    speed, facing: 0, casting: false, invulnerable: 0, spectral: false,
+  } as never;
+}
+
+describe('PlayerAvatar elige la marcha y pisa', () => {
+  const scene = new Scene(new NullEngine());
+  const ground = { sample: () => 0 } as never;
+  const mat = new StandardMaterial('m', scene);
+  void mat;
+  // El movimiento real: la simulación mueve prevPos→pos; aquí basta con que
+  // isPlayerMoving vea path, speed>0 y delta nulo → delta se calcula, hay que
+  // mover prevPos. Se reconstruye el player cada llamada.
+  function movingPlayer(speed: number): Parameters<PlayerAvatar['sync']>[0] {
+    return {
+      alive: true, pos: { x: speed * 0.016, y: 0 }, prevPos: { x: 0, y: 0 }, path: [new Vector3(1, 0, 0)],
+      speed, facing: 0, casting: false, invulnerable: 0, spectral: false,
+    } as never;
+  }
+  it('a paso lento pide walk y a tope pide run (modelo con clip)', () => {
+    const av = new PlayerAvatar(scene, new FakeModel(true, scene), ground);
+    av.sync(movingPlayer(1), 0, 0, 0, 0.016);
+    expect(av.model.state).toBe('walk');
+    av.sync(movingPlayer(2.75), 0, 0, 0, 0.016);
+    expect(av.model.state).toBe('run');
+    av.sync({ alive: true, pos: { x: 0, y: 0 }, prevPos: { x: 0, y: 0 }, path: [], speed: 0, facing: 0, casting: false, invulnerable: 0, spectral: false } as never, 0, 0, 0, 0.016);
+    expect(av.model.state).toBe('idle');
+  });
+  it('la histéresis vive en el avatar: parado en medio de la banda sigue corriendo', () => {
+    const av = new PlayerAvatar(scene, new FakeModel(true, scene), ground);
+    av.sync(movingPlayer(2.75), 0, 0, 0, 0.016);
+    expect(av.model.state).toBe('run');
+    av.sync(movingPlayer(2.75 * 0.8), 0, 0, 0, 0.016); // dentro de la banda
+    expect(av.model.state, 'sigue corriendo hasta bajar de runExit').toBe('run');
+    av.sync(movingPlayer(2.75 * 0.7), 0, 0, 0, 0.016);
+    expect(av.model.state).toBe('walk');
+    av.sync(movingPlayer(2.75 * 0.8), 0, 0, 0, 0.016);
+    expect(av.model.state, 'y sigue andando hasta llegar a runEnter').toBe('walk');
+  });
+  it('modelo sin clip Caminar (animales, PNJ de bicho): nunca pide walk', () => {
+    const av = new PlayerAvatar(scene, new FakeModel(false, scene), ground);
+    av.sync(movingPlayer(0.2), 0, 0, 0, 0.016);
+    expect(av.model.state).toBe('run');
+    expect((av.model as FakeModel).plays).not.toContain('walk');
+  });
+  it('montado sigue sin caminar el jinete', () => {
+    const fake = new FakeModel(true, scene);
+    const av = new PlayerAvatar(scene, fake, ground);
+    av.sync(movingPlayer(2.75), 0, 0, 0, 0.016, true, true);
+    expect(fake.played).toBe('idle');
+  });
+});
